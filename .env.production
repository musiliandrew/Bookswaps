# PRODUCTION ENVIRONMENT VARIABLES
# ⚠️  NEVER COMMIT THIS FILE TO VERSION CONTROL

# Database Configuration
DB_NAME=bookswaps_prod
DB_USER=bookswaps_user
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_32_CHARS_MIN
DB_HOST=db
DB_PORT=5432

# Django Configuration
SECRET_KEY=CHANGE_THIS_TO_STRONG_SECRET_KEY_50_CHARS_MIN_RANDOM
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Frontend URL (your production domain)
FRONTEND_URL=https://yourdomain.com

# Google OAuth Configuration (Production)
GOOGLE_OAUTH_CLIENT_ID=your_production_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_production_google_oauth_client_secret

# MinIO Configuration (Production)
MINIO_ACCESS_KEY=CHANGE_THIS_TO_STRONG_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_THIS_TO_STRONG_SECRET_KEY_32_CHARS_MIN
MINIO_BUCKET_NAME=bookswaps-prod
MINIO_ENDPOINT_URL=https://yourdomain.com:9000
MINIO_REGION=us-east-1

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Email Configuration (Production SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your_production_email_app_password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_production_google_maps_api_key

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# WebSocket URL (Production)
VITE_WS_URL=wss://yourdomain.com/ws/
VITE_API_URL=https://yourdomain.com/api/
